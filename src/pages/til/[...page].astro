---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TilFeed from "../../components/TilFeed.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths({ paginate }) {
  const entries = await getCollection("til");
  entries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(entries, { pageSize: 15 });
}

const { page } = Astro.props;
---

<BaseLayout title="Today I Learned" sideBarActiveItemID="til">
  <TilFeed page={page} heading="Today I Learned" />
</BaseLayout>
