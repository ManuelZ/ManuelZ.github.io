---

---

<div
  class="not-prose my-6 p-5 border border-base-300 rounded-xl bg-base-200 max-w-sm"
>
  <h3 class="text-base font-semibold mb-4">Mutual Distance Error Calculator</h3>

  <label class="block mb-3 text-sm">
    Depth z (mm)
    <input
      id="md-z"
      type="number"
      value="600"
      min="1"
      step="1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <label class="block mb-3 text-sm">
    Depth measurement error &delta;z (mm)
    <input
      id="md-dz"
      type="number"
      value="1"
      min="0"
      step="0.1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <label class="block mb-3 text-sm">
    Focal length &Omega; (pixels)
    <input
      id="md-omega"
      type="number"
      value="456"
      min="1"
      step="1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <label class="block mb-3 text-sm">
    Focal length calibration error &delta;&Omega; (pixels)
    <input
      id="md-dOmega"
      type="number"
      value="30"
      step="1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <label class="block mb-3 text-sm">
    Pixel distance between projections r (pixels)
    <input
      id="md-r"
      type="number"
      value="228"
      min="0"
      step="1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <label class="block mb-4 text-sm">
    Pixel distance error &delta;r (pixels)
    <input
      id="md-dr"
      type="number"
      value="1"
      step="1"
      class="mt-1 input input-sm input-bordered w-full"
    />
  </label>

  <button id="md-btn" class="btn btn-primary btn-sm w-full">Calculate</button>

  <div id="md-results" class="mt-4 hidden">
    <div class="text-sm font-mono space-y-1">
      <p id="md-result-R"></p>
      <p id="md-result-dR"></p>
      <hr class="border-base-300 my-1" />
      <p id="md-result-dz-z"></p>
      <p id="md-result-dO-O"></p>
      <p id="md-result-z-O"></p>
    </div>
  </div>
  <p id="md-error" class="mt-4 text-sm text-error hidden"></p>
</div>

<script>
  const btn = document.getElementById("md-btn")!;
  const resultsBox = document.getElementById("md-results")!;
  const errorEl = document.getElementById("md-error")!;
  const resultR    = document.getElementById("md-result-R")!;
  const resultDR   = document.getElementById("md-result-dR")!;
  const resultDzZ  = document.getElementById("md-result-dz-z")!;
  const resultDOO  = document.getElementById("md-result-dO-O")!;
  const resultZO   = document.getElementById("md-result-z-O")!;

  btn.addEventListener("click", () => {
    const r = parseFloat(
      (document.getElementById("md-r") as HTMLInputElement).value,
    );
    const z = parseFloat(
      (document.getElementById("md-z") as HTMLInputElement).value,
    );
    const omega = parseFloat(
      (document.getElementById("md-omega") as HTMLInputElement).value,
    );
    const dz = parseFloat(
      (document.getElementById("md-dz") as HTMLInputElement).value,
    );
    const dOmega = parseFloat(
      (document.getElementById("md-dOmega") as HTMLInputElement).value,
    );
    const dr = parseFloat(
      (document.getElementById("md-dr") as HTMLInputElement).value,
    );



    errorEl.classList.add("hidden");

    const R = (r * z) / omega;
    const dR = R * (dz / z - dOmega / omega) + (dr * z) / omega;

    resultR.textContent   = `R      = ${R.toFixed(2)} mm`;
    resultDR.textContent  = `δR     = ${dR.toFixed(2)} mm`;
    resultDzZ.textContent = `δz/z   = ${(dz / z).toFixed(4)}`;
    resultDOO.textContent = `δΩ/Ω   = ${(dOmega / omega).toFixed(4)}`;
    resultZO.textContent  = `z/Ω    = ${(z / omega).toFixed(4)} mm/px`;

    resultsBox.classList.remove("hidden");
  });
</script>
