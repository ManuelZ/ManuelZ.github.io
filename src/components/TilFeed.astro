---
import TilEntry from "./TilEntry.astro";

const { page, heading } = Astro.props;
---

<div class="mb-5">
  <div class="text-3xl w-full font-bold">{heading}</div>
  <p class="mt-2 opacity-80">
    Short notes on small things picked up along the way. Shorter and less
    polished than the <a href="/blog/" class="link">blog</a> posts.
  </p>
</div>

{
  page.data.length === 0 ? (
    <div class="bg-base-200 border-l-4 border-secondary w-full p-4 min-w-full">
      <p class="font-bold">Sorry!</p>
      <p>There are no entries to show at the moment. Check back later!</p>
    </div>
  ) : (
    <ul>
      {page.data.map((entry) => (
        <li class="list-none">
          <TilEntry entry={entry} />
          <div class="divider my-6" />
        </li>
      ))}
    </ul>
  )
}

<div class="flex justify-between">
  {
    page.url.prev ? (
      <a href={page.url.prev} class="btn btn-ghost my-10 mx-5">
        <svg
          class="h-6 w-6 fill-current md:h-8 md:w-8"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
        </svg>
        Newer entries
      </a>
    ) : (
      <div />
    )
  }
  {
    page.url.next ? (
      <a href={page.url.next} class="btn btn-ghost my-10 mx-5">
        Older entries
        <svg
          class="h-6 w-6 fill-current md:h-8 md:w-8"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
        >
          <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
        </svg>
      </a>
    ) : (
      <div />
    )
  }
</div>
